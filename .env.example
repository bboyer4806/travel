# Default for local development: ./data/travel.sqlite
TRAVEL_DATABASE_PATH=./data/travel.sqlite

# Sign in with Google, the only way in. The server refuses to start until all three are set.
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET come from a Google OAuth web client whose authorized
# redirect URIs include, for running locally, http://localhost:3000/auth/google/callback
# There is no stand-in for Google. See README.md and docs/DEPLOYMENT.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Google account authorized during initial setup.
TRAVEL_OWNER_EMAIL=

# Server-only Jira feedback settings. Use the local stand-in for development:
# node scripts/jira-feedback-stub.mjs
# JIRA_URL=http://127.0.0.1:3010
# JIRA_EMAIL=stub@example.test
# JIRA_API_TOKEN=local-stand-in
# Production: configure the real HTTPS Jira URL, account email, and API token on the host.
