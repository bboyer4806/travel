# Default for local development: ./data/travel.sqlite
TRAVEL_DATABASE_PATH=./data/travel.sqlite

# Server-only Google Sign In settings (Auth.js). See README.md and docs/DEPLOYMENT.md.
# AUTH_SECRET needs at least 32 random characters, for example from: openssl rand -base64 33
# AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET come from a Google OAuth web client that allows
# http://localhost:3000/api/auth/callback/google
# TRAVEL_OWNER_EMAIL is the Google account authorized during initial setup.
# Production also sets AUTH_URL to the public HTTPS address, for example https://travel.dev.boyersoftware.com
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# TRAVEL_OWNER_EMAIL=

# Server-only Jira feedback settings. Use the local stand-in for development:
# node scripts/jira-feedback-stub.mjs
# JIRA_URL=http://127.0.0.1:3010
# JIRA_EMAIL=stub@example.test
# JIRA_API_TOKEN=local-stand-in
# Production: configure the real HTTPS Jira URL, account email, and API token on the host.
