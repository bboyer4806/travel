TRAVEL_DATABASE_PATH=./data/travel.sqlite

# Server-only Jira feedback settings. Use the local stand-in for development:
# node scripts/jira-feedback-stub.mjs
# JIRA_URL=http://127.0.0.1:3010
# JIRA_EMAIL=stub@example.test
# JIRA_API_TOKEN=local-stand-in
# Production: configure the real HTTPS Jira URL, account email, and API token on the host.
